# === 必填 ===
# MailAgent sync_store.db 路径（绝对路径或相对于项目根）
SYNC_STORE_DB_PATH=/path/to/MailAgent/data/sync_store.db

# === 可选 ===
WEB_API_PORT=8200
WEB_API_TOKEN=          # 为空=开发模式免认证

# Redis（用于 mark_done/toggle_flag 等操作同步到 Mail.app）
REDIS_URL=redis://localhost:6379
REDIS_DB=2

# Notion（正文读取 + 构造链接）
NOTION_TOKEN=
EMAIL_DATABASE_ID=

# LLM Agent（翻译/摘要/起草回复）
LLM_API_KEY=
LLM_API_BASE=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_SEC=120
